[user]
	name = Jacob Lineberry
[init]
	defaultBranch = main
[core]
	pager = "if command -v delta >/dev/null; then delta; else less; fi"
[interactive]
	diffFilter = "if command -v delta >/dev/null; then delta --color-only; else cat; fi"
[delta]
	navigate = true
	line-numbers = true
	dark = true
	syntax-theme = tokyonight_storm
	file-style = bold "#7dcfff"
	file-decoration-style = "#565f89" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#565f89" box ul
	commit-decoration-style = "#565f89" bold box ul
	line-numbers-left-style = "#565f89"
	line-numbers-right-style = "#565f89"
	line-numbers-zero-style = "#565f89"
	line-numbers-minus-style = bold "#f7768e"
	line-numbers-plus-style = bold "#9ece6a"
	minus-style = syntax "#37222e"
	minus-emph-style = bold syntax "#52313f"
	plus-style = syntax "#203444"
	plus-emph-style = bold syntax "#2b485a"
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictStyle = zdiff3
[pull]
	ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	lg = log --graph --oneline --decorate -n 20
	last = log -1 HEAD --stat
	unstage = restore --staged
	amend = commit --amend --no-edit
	fixup = commit --fixup
# Machine-specific identity, signing and ignores (untracked; skipped if missing)
[include]
	path = ~/.corp/gitconfig
# Public identity for the dotfiles repo (wins over the include above)
[includeIf "gitdir:~/dotfiles/"]
	path = ~/.config/git/personal

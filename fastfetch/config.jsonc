{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 1, "right": 2 },
    "color": { "1": "38;2;187;154;247", "2": "38;2;122;162;247" }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "keyColor": "38;2;187;154;247" },
    { "type": "host", "key": "Host", "keyColor": "38;2;125;207;255" },
    { "type": "kernel", "key": "Kernel", "keyColor": "38;2;125;207;255" },
    { "type": "uptime", "key": "Uptime", "keyColor": "38;2;115;218;202" },
    { "type": "packages", "key": "Packages", "keyColor": "38;2;158;206;105" },
    { "type": "shell", "key": "Shell", "keyColor": "38;2;224;175;104" },
    { "type": "display", "key": "Display", "keyColor": "38;2;255;158;100" },
    { "type": "terminal", "key": "Terminal", "keyColor": "38;2;247;118;142" },
    { "type": "cpu", "key": "CPU", "keyColor": "38;2;157;124;216" },
    { "type": "memory", "key": "Memory", "keyColor": "38;2;187;154;247" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "color": {
      "1": "38;2;187;154;247",
      "2": "38;2;122;162;247"
    },
    "source": "$1           ___\n          /\\  \\\n         /  \\  \\\n        /    \\  \\\n       /  /\\  \\  \\\n      /  /  \\  \\  \\\n     /  /  / \\  \\  \\\n    /  /  /   \\  \\  \\\n   /  /  /     \\  \\  \\\n  /  /  /       \\  \\  \\\n $2/  /  /_________\\__\\  \\\n/  /  /_________________\\\n\\ /_____________________/",
    "padding": { "top": 1, "left": 1, "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;65;72;104"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;65;72;104m╭─ \u001b[1;38;2;187;154;247mSYSTEM\u001b[0;38;2;65;72;104m ────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "│ {#38;2;187;154;247}{icon} os        {#keys}│"
    },
    {
      "type": "kernel",
      "key": "│ {#38;2;122;162;247} kernel    {#keys}│"
    },
    {
      "type": "uptime",
      "key": "│ {#38;2;125;207;255}󰅐 uptime    {#keys}│"
    },
    {
      "type": "packages",
      "key": "│ {#38;2;115;218;202}󰏖 pkgs      {#keys}│"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;65;72;104m├─ \u001b[1;38;2;158;206;105mDESKTOP\u001b[0;38;2;65;72;104m ───┤\u001b[0m"
    },
    {
      "type": "wm",
      "key": "│ {#38;2;158;206;105} wm        {#keys}│"
    },
    {
      "type": "terminal",
      "key": "│ {#38;2;224;175;104} term      {#keys}│"
    },
    {
      "type": "shell",
      "key": "│ {#38;2;255;158;100} shell     {#keys}│"
    },
    {
      "type": "display",
      "key": "│ {#38;2;247;118;142}󰍹 display   {#keys}│",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;65;72;104m├─ \u001b[1;38;2;122;162;247mHARDWARE\u001b[0;38;2;65;72;104m ──┤\u001b[0m"
    },
    {
      "type": "host",
      "key": "│ {#38;2;187;154;247}󰌢 host      {#keys}│"
    },
    {
      "type": "cpu",
      "key": "│ {#38;2;122;162;247} cpu       {#keys}│"
    },
    {
      "type": "gpu",
      "key": "│ {#38;2;125;207;255}󰾲 gpu       {#keys}│"
    },
    {
      "type": "memory",
      "key": "│ {#38;2;115;218;202} memory    {#keys}│"
    },
    {
      "type": "disk",
      "key": "│ {#38;2;158;206;105} disk      {#keys}│",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;65;72;104m╰─────────────╯\u001b[0m"
    },
    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    }
  ]
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 1, "right": 2 },
    "color": { "1": "38;2;245;194;231", "2": "38;2;203;166;247" }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "keyColor": "38;2;245;194;231" },
    { "type": "host", "key": "Host", "keyColor": "38;2;203;166;247" },
    { "type": "kernel", "key": "Kernel", "keyColor": "38;2;137;180;250" },
    { "type": "uptime", "key": "Uptime", "keyColor": "38;2;148;226;213" },
    { "type": "packages", "key": "Packages", "keyColor": "38;2;166;227;161" },
    { "type": "shell", "key": "Shell", "keyColor": "38;2;249;226;175" },
    { "type": "display", "key": "Display", "keyColor": "38;2;250;179;135" },
    { "type": "terminal", "key": "Terminal", "keyColor": "38;2;243;139;168" },
    { "type": "cpu", "key": "CPU", "keyColor": "38;2;180;190;254" },
    { "type": "memory", "key": "Memory", "keyColor": "38;2;203;166;247" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
